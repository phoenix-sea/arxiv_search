# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high ; empty = model default. Thinking tokens are billed as output.
GEMINI_THINKING_LEVEL=minimal
# papers per request, and max requests per minute (lower this on the free tier)
GEMINI_BATCH_SIZE=20
GEMINI_RPM=10

# --- Telegram: create a bot with @BotFather, message it once, then run
#     .venv/bin/arxiv-search telegram-chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# notify for new papers with relevance >= this (0-10), optionally importance >= this
NOTIFY_MIN_RELEVANCE=7
NOTIFY_MIN_IMPORTANCE=0
# max individual paper messages per run (the digest message counts the rest)
NOTIFY_MAX_PER_RUN=15

# --- Index ---
DB_PATH=data/arxiv.db
CATEGORIES=cs.IR,cs.CL,cs.AI,cs.LG
# what Gemini scores relevance against
PROFILE_PATH=profile.md
# each run re-checks this many days before the newest stored paper
LOOKBACK_DAYS=3

# --- Web UI ---
WEB_HOST=0.0.0.0
WEB_PORT=8000
# used for links in Telegram messages
PUBLIC_URL=http://raspberrypi.local:8000
