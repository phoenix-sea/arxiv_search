[Unit]
Description=arXiv search daily job (crawl, affiliations, Gemini, Telegram, affiliation backfill)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@APP_DIR@
ExecStart=@APP_DIR@/.venv/bin/arxiv-search update
# New papers take under an hour; the job then backfills older papers' affiliations and
# stops by itself 30 minutes before the next 03:00 UTC run.
TimeoutStartSec=24h
Nice=10
IOSchedulingClass=idle
